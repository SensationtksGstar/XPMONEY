{
  "framework": "nextjs",
  "regions": ["fra1"],
  "functions": {
    "src/app/api/webhooks/stripe/route.ts": {
      "maxDuration": 30
    },
    "src/app/api/notifications/send/route.ts": {
      "maxDuration": 60
    },
    "src/app/api/cron/vigia/route.ts": {
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/api/notifications/send",
      "schedule": "0 18 * * *"
    },
    {
      "path": "/api/notifications/send?mode=streak-rescue",
      "schedule": "30 21 * * *"
    },
    {
      "path": "/api/cron/vigia",
      "schedule": "0 7 * * *"
    }
  ]
}
